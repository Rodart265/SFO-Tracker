rules_version = '2';

/*
  SFO Field Tracker: Cloud Storage rules (visit photos).

  Photos live at  visits/<visitId>/<photoId>.jpg  and are written by the app after
  it resizes them on the phone. Same roles as Firestore (users/<uid>.role):
    member / admin   read photos, add a photo (JPEG, under 2 MB)
    admin            delete a photo
  Anything else in the bucket is closed.
*/

service firebase.storage {
  match /b/{bucket}/o {

    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && role() in ['member', 'admin'];
    }
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && role() == 'admin';
    }

    match /visits/{visitId}/{photoId} {
      allow read: if isMember();
      // Members may write a photo, and write it again: the app retries an upload
      // with the same file name when the connection drops half way, and that
      // retry counts as an update. Only admins can delete.
      allow create, update: if isMember()
        && request.resource.contentType.matches('image/jpeg')
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
